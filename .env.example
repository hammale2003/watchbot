# Firecrawl - get a free key at https://firecrawl.dev (1000 free credits/month)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Choose ONE LLM provider ---
# LLM_PROVIDER must be one of: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# API key for whichever provider you picked above
LLM_API_KEY=your-api-key-here

# (Optional) override the default model. If left blank, sensible defaults are used:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-5.1
#   gemini    -> gemini-2.5-pro
LLM_MODEL=

# --- Email (Gmail example) ---
# EMAIL_PASSWORD must be a Gmail "App Password", not your normal password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_FROM=hammalemourad@gmail.com
EMAIL_TO=hammalemourad@gmail.com 
EMAIL_PASSWORD=your-gmail-app-password
